{
  "rules": {
    "usernames": {
      "$usernameKey": {
        ".read": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".write": "auth != null && (($usernameKey.matches(/^[a-z0-9_]{6,18}$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))) || ($usernameKey.matches(/^[0-9a-f]{2}(_[0-9a-f]{2}){5,17}$/) && data.val() === auth.uid && !newData.exists()))",
        ".validate": "!newData.exists() || (newData.isString() && newData.val() === auth.uid && $usernameKey.matches(/^[a-z0-9_]{6,18}$/))"
      }
    },
    "lists": {
      "$listId": {
        ".read": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() ? (newData.child('owner').val() === auth.uid && newData.child('members').child(auth.uid).val() === true) : (!newData.exists() && root.child('lists').child($listId).child('owner').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.child('owner').isString() && newData.child('owner').val().length > 0 && newData.child('listName').isString() && newData.child('listName').val().length > 0 && newData.child('listName').val().length <= 80 && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber() && newData.child('lastEditedByUid').isString() && newData.child('lastEditedByUid').val().length > 0 && newData.child('lastEditedByUid').val().length <= 128 && newData.child('members').child(newData.child('owner').val()).val() === true)",
        "owner": {
          ".write": "auth != null && ((data.exists() && data.val() === auth.uid && newData.val() !== auth.uid && root.child('lists').child($listId).child('members').child(newData.val()).exists()) || (!data.exists() && newData.val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "listName": {
          ".write": "auth != null && root.child('lists').child($listId).child('owner').val() === auth.uid && newData.isString() && newData.val().length > 0 && newData.val().length <= 80",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "createdAt": {
          ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isNumber()",
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isNumber()",
          ".validate": "newData.isNumber()"
        },
        "lastEditedByUid": {
          ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && ((root.child('lists').child($listId).child('owner').val() === auth.uid && (newData.exists() || $uid !== auth.uid || !root.child('lists').child($listId).child('members').child($uid).exists())) || (auth.uid === $uid && !newData.exists()) || (auth.uid === $uid && !data.exists() && newData.exists()))",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        },
        "memberProfiles": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('lists').child($listId).child('owner').val() === auth.uid)",
            "username": {
              ".write": "auth != null && (auth.uid === $uid || root.child('lists').child($listId).child('owner').val() === auth.uid)",
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{6,18}$/)"
            }
          }
        },
        "items": {
          "$itemId": {
            ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists()",
            ".validate": "!newData.exists() || (newData.child('itemName').isString() && newData.child('itemName').val().length > 0 && newData.child('itemName').val().length <= 140 && newData.child('itemHighlighted').isBoolean() && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber() && newData.child('sortOrder').isString() && newData.child('sortOrder').val().length > 0 && newData.child('lastEditedByUid').isString() && newData.child('lastEditedByUid').val().length > 0 && newData.child('lastEditedByUid').val().length <= 128)",
            "itemName": {
              ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isString() && newData.val().length > 0 && newData.val().length <= 140",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
            },
            "itemHighlighted": {
              ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isBoolean()",
              ".validate": "newData.isBoolean()"
            },
            "createdAt": {
              ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isNumber()",
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isNumber()",
              ".validate": "newData.isNumber()"
            },
            "sortOrder": {
              ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.isString() && newData.val().length > 0",
              ".validate": "newData.isString() && newData.val().length > 0"
            },
            "lastEditedByUid": {
              ".write": "auth != null && root.child('lists').child($listId).child('members').child(auth.uid).exists() && newData.val() === auth.uid",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
            }
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 320"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{6,18}$/) && root.child('usernames').child(newData.val()).val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "lists": {
          "$listId": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('lists').child($listId).child('owner').val() === auth.uid))",
            ".validate": "!newData.exists() || newData.val() === true"
          }
        },
        "listNicknames": {
          "$listId": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
          }
        }
      }
    }
  }
}
